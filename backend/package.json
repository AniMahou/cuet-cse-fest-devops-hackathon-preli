{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t backend:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env backend:latest"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/jwt": "^7.2.0",
    "@fastify/rate-limit": "^8.0.0",
    "@fastify/redis": "^6.0.0",
    "@fastify/swagger": "^8.10.0",
    "@fastify/swagger-ui": "^1.7.0",
    "@fastify/type-provider-typebox": "^3.0.0",
    "@sinclair/typebox": "^0.28.0",
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^2.1.1",
    "bcryptjs": "^2.4.3",
    "convict": "^6.2.4",
    "dotenv": "^16.0.3",
    "fastify": "^4.21.0",
    "fastify-metrics": "^10.0.0",
    "mongoose": "^7.4.0",
    "pino": "^8.15.0",
    "prom-client": "^14.2.0",
    "redis": "^4.6.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.5",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.8.0",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^3.13.0",
    "typescript": "^5.2.2"
  }
}
